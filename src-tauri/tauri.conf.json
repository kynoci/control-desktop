{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control Desktop",
  "version": "0.1.0",
  "identifier": "com.kynoci.remote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Control Desktop",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kynoci",
    "copyright": "Copyright © 2026 kynoci",
    "license": "GPL-3.0-only",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
